#!/usr/bin/env bash
set -euo pipefail

# OpenGauss 0.2.2 unconditionally supplies
# --dangerously-bypass-approvals-and-sandbox to its Codex backend. This shim
# removes that flag and substitutes a bounded non-interactive policy.
REAL_CODEX="${PERCOLATION_OPENGAUSS_REAL_CODEX:-}"
if [ -z "$REAL_CODEX" ] || [ ! -x "$REAL_CODEX" ]; then
  printf '%s\n' \
    'Safe OpenGauss Codex shim: PERCOLATION_OPENGAUSS_REAL_CODEX is not an executable.' >&2
  exit 2
fi

filtered_args=()
skip_next=0
for argument in "$@"; do
  if [ "$skip_next" = "1" ]; then
    skip_next=0
    continue
  fi
  case "$argument" in
    --dangerously-bypass-approvals-and-sandbox)
      ;;
    --sandbox|-s|--ask-for-approval|-a)
      skip_next=1
      ;;
    --sandbox=*|--ask-for-approval=*)
      ;;
    *)
      filtered_args+=("$argument")
      ;;
  esac
done

exec "$REAL_CODEX" \
  --sandbox workspace-write \
  --ask-for-approval never \
  "${filtered_args[@]}"
